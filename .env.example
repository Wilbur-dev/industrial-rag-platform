# Application
APP_NAME=industrial-rag-platform
APP_ENV=development
LOG_LEVEL=INFO

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=64
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
TOP_K=5
SCORE_THRESHOLD=
MIN_GROUNDING_SCORE=0.0
PROMPT_VERSION=v1_grounded
EVAL_K_VALUES=1,3,5
EVAL_BENCHMARK_PATH=data/eval/retrieval_benchmark.json

# Qdrant
# 本机跑 API + Docker 只起 Qdrant：localhost
# 全 Docker Compose：由 compose 注入 qdrant，无需改
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
# corpus_topk.md + retrieval benchmark (keep separate from rag_overview.md)
QDRANT_TOPK_EVAL_COLLECTION=documents_topk

# Optional: OpenAI for grounded generation (Day 6)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
